<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Teresa Gradient Background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF6B9D"
                android:centerColor="#9C5CE5"
                android:endColor="#7C4DFF"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Teresa Logo -->
    <item
        android:width="100dp"
        android:height="100dp"
        android:gravity="center"
        android:drawable="@drawable/ic_teresa_logo"/>
</layer-list>
