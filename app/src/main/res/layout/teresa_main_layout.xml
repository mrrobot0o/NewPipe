<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background_color">

    <!-- Main Content Fragment -->
    <FrameLayout
        android:id="@+id/teresa_fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/teresa_bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Mini Player -->
    <LinearLayout
        android:id="@+id/teresa_mini_player"
        android:layout_width="0dp"
        android:layout_height="@dimen/teresa_mini_player_height"
        android:background="@drawable/teresa_mini_player_background"
        android:visibility="gone"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toTopOf="@id/teresa_bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Thumbnail -->
        <ImageView
            android:id="@+id/mini_player_thumbnail"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:background="@drawable/teresa_card_background" />

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/mini_player_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/mini_player_uploader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Controls -->
        <ImageButton
            android:id="@+id/mini_player_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/teresa_button_background"
            android:src="@drawable/ic_play"
            android:tint="@color/white" />

        <ImageButton
            android:id="@+id/mini_player_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:tint="#80FFFFFF" />
    </LinearLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/teresa_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/dark_background_color"
        android:elevation="8dp"
        app:itemIconTint="@color/teresa_bottom_nav_color"
        app:itemTextColor="@color/teresa_bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/teresa_bottom_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
